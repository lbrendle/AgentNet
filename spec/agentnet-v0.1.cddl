; AgentNet Protocol Suite v0.1 — Canonical CBOR Schemas (CDDL)
; =============================================================================
; This file defines the normative on‑wire schemas for AgentNet messages and
; AgentChain transactions, encoded as CBOR (RFC 8949) with Deterministic
; Encoding (a.k.a. Canonical CBOR).
;
; NORMATIVE RULES
;  - Encoding MUST use CBOR deterministic encoding:
;      * shortest-length encoding for integers and lengths
;      * map keys MUST be sorted in canonical order (RFC 8949 §4.2.1)
;  - Unless otherwise specified, signatures are:
;      sig = Ed25519( SHA-256( CBOR(signing_payload) ) )
;  - signing_payload is the object with its signature field(s) omitted.
;  - All timestamps are Unix seconds (uint).
;  - Floats MUST NOT appear in canonical objects in v0.1.
;  - Unknown map keys MUST be ignored (forward compatibility), except where
;    explicitly stated as "MUST reject".
;
; Debug note:
;  Implementations MAY expose JSON mirrors for developer UX. JSON is NOT
;  normative for hashing/signatures. Only canonical CBOR is normative.
; =============================================================================

; -------------------------
; Base scalar types
; -------------------------
u8  = uint .lt 256
u16 = uint .lt 65536
u32 = uint .lt 4294967296
u64 = uint .lt 18446744073709551616

unix_time = u64

hash32 = bstr .size 32
sig64  = bstr .size 64
pk_ed25519 = bstr .size 32
pk_x25519  = bstr .size 32
nonce16 = bstr .size 16

; IDs (v0.1 keeps these flexible; enforce stricter regex at higher layers)
id64 = tstr .size (1..64)
id128 = tstr .size (1..128)

chain_id = id64
node_id  = id64
topic    = id128

did = tstr .regexp "^did:anet:[A-Za-z0-9:._\\-/]+$"
multiaddr = tstr .size (1..256)

; -------------------------
; Enumerations / registries
; -------------------------
; These enums are normative. Unknown values MUST be treated as unsupported.

; PolicyDecision codes
PD_ALLOW            = 0
PD_DENY             = 1
PD_REQUIRE_APPROVAL = 2
PD_REQUIRE_BOND     = 3

policy_decision = PD_ALLOW / PD_DENY / PD_REQUIRE_APPROVAL / PD_REQUIRE_BOND

; Receipt event types
EV_ACTION_EXECUTED      = 1
EV_PAYMENT_SENT         = 2
EV_GRANT_USED           = 3
EV_APPROVAL_USED        = 4
EV_TASK_STATE_CHANGE    = 5
EV_POLICY_DECISION      = 6
EV_GOVERNANCE_EVENT     = 7
EV_SKILL_REGISTRY       = 9
EV_WORK_REGISTRY        = 10

receipt_event_type =
  EV_ACTION_EXECUTED /
  EV_PAYMENT_SENT /
  EV_GRANT_USED /
  EV_APPROVAL_USED /
  EV_TASK_STATE_CHANGE /
  EV_POLICY_DECISION /
  EV_GOVERNANCE_EVENT /
  EV_SKILL_REGISTRY /
  EV_WORK_REGISTRY

; AgentChain Tx types (module dispatch)
TX_IDENTITY_REGISTER   = 10
TX_IDENTITY_ROTATE     = 11
TX_CRED_REVOKE         = 12

TX_TRANSFER            = 20
TX_POSTAGE             = 21

TX_SKILL_PUBLISH        = 30
TX_SKILL_UPDATE         = 31
TX_SKILL_REVOKE         = 32

TX_ESCROW_LOCK         = 40
TX_ESCROW_RELEASE      = 41
TX_ESCROW_DISPUTE      = 42
TX_ESCROW_RESOLVE      = 43

TX_WORK_OFFER_PUBLISH      = 50
TX_WORK_AGREEMENT_PUBLISH  = 51
TX_WORK_AGREEMENT_UPDATE   = 52
TX_WORK_AGREEMENT_CLOSE    = 53

TX_RECEIPT_ANCHOR      = 70

TX_GOV_PROPOSAL        = 60
TX_GOV_VOTE            = 61
TX_GOV_FINALIZE        = 62

tx_type =
  TX_IDENTITY_REGISTER /
  TX_IDENTITY_ROTATE /
  TX_CRED_REVOKE /
  TX_TRANSFER /
  TX_POSTAGE /
  TX_SKILL_PUBLISH /
  TX_SKILL_UPDATE /
  TX_SKILL_REVOKE /
  TX_ESCROW_LOCK /
  TX_ESCROW_RELEASE /
  TX_ESCROW_DISPUTE /
  TX_ESCROW_RESOLVE /
  TX_WORK_OFFER_PUBLISH /
  TX_WORK_AGREEMENT_PUBLISH /
  TX_WORK_AGREEMENT_UPDATE /
  TX_WORK_AGREEMENT_CLOSE /
  TX_RECEIPT_ANCHOR /
  TX_GOV_PROPOSAL /
  TX_GOV_VOTE /
  TX_GOV_FINALIZE

; -------------------------
; 1) Handshake (agentnet/handshake/1.0.0)
; -------------------------

Features = {
  ?0: [* tstr],   ; encodings (e.g., ["cbor"])
  ?1: u64,        ; max_msg_bytes
  ?2: bool,       ; supports_receipt_anchoring
  ?3: tstr        ; time_sync (e.g., "unix")
}

NodeHelloPayload = {
  0: [* id128],   ; supported protocol IDs
  1: chain_id,
  2: node_id,
  3: pk_ed25519,
  4: [* tstr],    ; roles, e.g. ["mesh","relay","validator"]
  5: Features,
  6: unix_time,
  7: nonce16
}

NodeHello = NodeHelloPayload & { 8: sig64 }

; -------------------------
; 2) DHT Records (agentnet/dht/1.0.0)
; -------------------------

Contact = {
  0: [* node_id],
  1: [* multiaddr]
}

AgentRecordPayload = {
  0: did,              ; agent_id
  1: [* pk_ed25519],   ; agent_pubkeys (current)
  2: Contact,
  3: [* tstr],         ; capabilities
  4: unix_time         ; expires
}

AgentRecord = AgentRecordPayload & { 5: sig64 }

; service_type is an extensible integer registry (v0.1 keeps it open)
service_type = u16

ServiceRecordPayload = {
  0: did,          ; provider_id (agent DID)
  1: service_type,
  2: [* multiaddr],
  ?3: [* tstr],    ; required credential types
  ?4: any,         ; pricing model (informational only, non-consensus)
  5: unix_time     ; expires
}

ServiceRecord = ServiceRecordPayload & { 6: sig64 }

CommunityRecordPayload = {
  0: id64,         ; community_id
  1: did,          ; community_controller (who signs updates)
  2: u8,           ; join_policy: 0=open, 1=credential, 2=invite
  ?3: [* tstr],    ; required credential types
  4: any,          ; economics policy pointer (e.g., chain params ref)
  5: any,          ; governance policy pointer (e.g., chain params ref)
  6: unix_time     ; expires
}

CommunityRecord = CommunityRecordPayload & { 7: sig64 }

; -------------------------
; 3) PubSub (agentnet/pubsub/1.0.0)
; -------------------------

; Economic proof types for messages (anti-spam)
PROOF_ONCHAIN_TX = 1
PROOF_VOUCHER    = 2

OnChainTxProof = { 0: PROOF_ONCHAIN_TX, 1: hash32 }   ; tx hash
VoucherProof   = { 0: PROOF_VOUCHER,    1: bstr }     ; opaque signed voucher

EconomicProof = OnChainTxProof / VoucherProof

PubSubEnvelopePayload = {
  0: u8,        ; version (1)
  1: topic,
  2: did,       ; sender
  3: unix_time, ; ts
  4: u64,       ; seq
  5: u16,       ; payload_type (registry)
  6: any,       ; payload
  ?7: EconomicProof
}

PubSubEnvelope = PubSubEnvelopePayload & { 8: sig64 }

; PubSub payload registry (subset)
PT_AGENTMAIL = 1000
PT_KILL_SWITCH = 65535

KillSwitchPayloadUnsigned = {
  0: u8,        ; action: 0=engage, 1=release
  1: tstr,      ; reason
  2: unix_time, ; ts
  3: nonce16
}

KillSwitchPayload = KillSwitchPayloadUnsigned & { 4: sig64 }

; -------------------------
; 3a) AgentMail (agentnet/mail/1.0.0)
; -------------------------

AgentMailAttachment = {
  0: hash32,     ; content hash
  1: u64,        ; size bytes
  2: tstr,       ; mime
  ?3: [* multiaddr] ; retrieval hints
}

AgentMailMessagePayload = {
  0: u8,         ; version (1)
  1: id64,       ; message_id
  2: did,        ; from
  3: [* did],    ; to (one or more recipients)
  ?4: id64,      ; thread_id
  ?5: id64,      ; reply_to
  ?6: tstr,      ; subject
  7: tstr,       ; markdown body (exchange profile)
  ?8: [* AgentMailAttachment],
  ?9: [* hash32],  ; intent hashes
  ?10: [* hash32], ; receipt hashes
  ?11: any,        ; metadata (opaque)
  12: unix_time, ; ts
  ?13: unix_time ; expires
}

AgentMailMessage = AgentMailMessagePayload & { 14: sig64 }

; -------------------------
; 4) Agent-to-Agent Tasks (agentnet/task/1.0.0)
; -------------------------

; Task state enum (registry)
TASK_PROPOSED    = 0
TASK_ACCEPTED    = 1
TASK_IN_PROGRESS = 2
TASK_DELIVERED   = 3
TASK_FAILED      = 4
TASK_CLOSED      = 5
task_state = TASK_PROPOSED / TASK_ACCEPTED / TASK_IN_PROGRESS / TASK_DELIVERED / TASK_FAILED / TASK_CLOSED

; Payment contract types
PC_NONE   = 0
PC_ESCROW = 1
payment_contract_type = PC_NONE / PC_ESCROW

PaymentContract = {
  0: payment_contract_type,
  ?1: u64,      ; amount
  ?2: tstr,     ; currency (e.g., "ANET")
  ?3: any,      ; release_condition (opaque)
  ?4: u64,      ; dispute_window_sec
  ?5: unix_time ; expiry
}

TaskOfferPayload = {
  0: id64,      ; task_id
  1: did,       ; from
  2: did,       ; to
  3: tstr,      ; summary
  4: any,       ; inputs (opaque)
  5: PaymentContract,
  6: unix_time  ; expires
}

TaskOffer = TaskOfferPayload & { 7: sig64 }

ArtifactDescriptor = {
  0: hash32,     ; content hash
  1: u64,        ; size bytes
  2: tstr,       ; mime
  ?3: [* multiaddr] ; retrieval hints
}

TaskUpdatePayload = {
  0: id64,      ; task_id
  1: did,       ; from
  2: task_state,
  ?3: tstr,     ; message
  ?4: [* ArtifactDescriptor],
  5: unix_time
}

TaskUpdate = TaskUpdatePayload & { 6: sig64 }

; -------------------------
; 5) Pairing & Delegation (agentnet/pair/1.0.0)
; -------------------------

; Pairing messages are exchanged over AgentMesh secure channels.
; Pairing results in a PairingContract.

PairingInitPayload = {
  0: id64,  ; pairing_id
  1: did,   ; principal_id
  2: did,   ; agent_id
  3: any,   ; requested policies + constraints (opaque in v0.1)
  4: nonce16,
  5: unix_time
}
PairingInit = PairingInitPayload & { 6: sig64 } ; signed by principal

PairingAckPayload = {
  0: id64,  ; pairing_id
  1: did,   ; agent_id
  2: did,   ; principal_id
  3: any,   ; agent capabilities + negotiated parameters
  4: nonce16,
  5: unix_time
}
PairingAck = PairingAckPayload & { 6: sig64 } ; signed by agent

PairingContractPayload = {
  0: id64,      ; pairing_id
  1: did,       ; principal_id
  2: did,       ; agent_id
  3: unix_time, ; created
  4: unix_time, ; expires
  5: bool,      ; pairwise_mode (privacy)
  6: any,       ; default policies (risk mode, data boundary, etc.)
  7: any,       ; grant issuance constraints
  8: any        ; revocation descriptor (onchain ref, keys, etc.)
}
PairingContract = PairingContractPayload & {
  9: sig64,   ; principal signature
  10: sig64   ; agent signature
}

; Delegated Grants
GrantPayload = {
  0: id64,     ; grant_id
  1: did,      ; issuer (principal)
  2: did,      ; subject (agent)
  3: id64,     ; pairing_id
  4: [* tstr], ; scopes
  5: any,      ; constraints (budget/time/allowlists)
  6: any,      ; revocation ref
  7: unix_time ; exp
}
Grant = GrantPayload & { 8: sig64 }  ; signed by principal

; ActionIntent (what the agent proposes to do)
ActionIntent = {
  0: id64,      ; intent_id
  1: did,       ; actor agent_id
  2: id64,      ; pairing_id
  3: tstr,      ; action_type
  4: any,       ; target
  5: u64,       ; max_cost
  6: tstr,      ; currency
  7: tstr,      ; reason
  8: [* tstr],  ; context_refs
  9: unix_time  ; ts
}

; Approval binds to ActionIntent hash (sha256(cbor(ActionIntent)))
ApprovalPayload = {
  0: id64,      ; approval_id
  1: did,       ; issuer (principal)
  2: hash32,    ; intent_hash
  3: unix_time  ; exp
}
Approval = ApprovalPayload & { 4: sig64 }

; -------------------------
; 6) Policy Gate (local, not consensus)
; -------------------------

PolicyCheckRequest = {
  0: did,        ; agent_id
  1: id64,       ; pairing_id
  2: ActionIntent,
  3: [* id64],   ; presented grant_ids (references)
  4: id64 / null ; approval_id or null
  5: any,        ; estimated economics context
  6: id64 / null ; community_id or null
}

PolicyDecision = {
  0: policy_decision,
  1: [* tstr],    ; reason codes
  ?2: any,        ; required (approval/bond details)
  3: hash32,      ; policy_hash
  4: sig64        ; policy-gate signature (node-local)
}

; -------------------------
; 7) Receipts & Anchoring (agentnet/receipt/1.0.0)
; -------------------------

; ReceiptPayload is the signing payload (receipt_hash = sha256(cbor(ReceiptPayload)))
ReceiptPayload = {
  0: id64,        ; receipt_id
  1: unix_time,   ; ts
  2: did,         ; actor_agent
  3: id64 / null, ; pairing_id (null allowed)
  4: id64 / null, ; community_id (null allowed)
  5: { 0: receipt_event_type, 1: any }, ; event {type, details}
  6: { 0: [* id64], 1: id64 / null, 2: hash32 }, ; auth {grant_ids, approval_id, policy_hash}
  7: { 0: any, 1: any }, ; economics {postage, bond} (opaque maps v0.1)
  8: hash32,      ; prev_hash
  9: u64          ; seq (monotonic per receipt chain)
}

Receipt = ReceiptPayload & {
  10: hash32, ; receipt_hash
  11: sig64   ; actor signature over receipt_hash
}

ReceiptAnchorTxPayload = {
  0: did,     ; agent_id
  1: id64,    ; receipt_chain_id
  2: hash32,  ; root_hash (implementation-defined: Merkle root or last receipt hash)
  3: { 0: u64, 1: u64 }, ; range {from_seq, to_seq}
  4: unix_time
}

ReceiptAnchorTx = ReceiptAnchorTxPayload & { 5: sig64 }

; -------------------------
; 8) AgentChain Transaction Envelope (anet/tx/1.0.0)
; -------------------------

TxEnvelopePayload = {
  0: tx_type,
  1: did,      ; sender
  2: u64,      ; nonce
  3: u64,      ; fee
  4: any       ; module payload
}
TxEnvelope = TxEnvelopePayload & { 5: sig64 }

; --- Identity module payloads ---

IdentityRegisterPayload = {
  0: did,         ; agent_id
  1: pk_ed25519,  ; primary signing key
  2: pk_x25519,   ; key agreement
  3: unix_time    ; created
}

IdentityRotatePayload = {
  0: did,         ; agent_id
  1: pk_ed25519,  ; new signing key
  2: pk_x25519,   ; new agreement key
  3: unix_time
}

CredentialRevokePayload = {
  0: did,      ; issuer
  1: hash32,   ; credential_id_hash
  2: unix_time
}

; --- Economy module payloads ---

TransferPayload = {
  0: did,    ; from
  1: did,    ; to
  2: u64,    ; amount
  3: tstr,   ; currency ("ANET")
  4: unix_time
}

PostagePayload = {
  0: did,    ; payer
  1: u64,    ; amount
  2: tstr,   ; currency
  3: id64,   ; purpose ("dm:first_contact", "community_post", etc.)
  4: unix_time
}

; --- Escrow module payloads ---
EscrowLockPayload = {
  0: id64,   ; escrow_id
  1: did,    ; payer
  2: did,    ; payee
  3: u64,    ; amount
  4: tstr,   ; currency
  5: any,    ; release_condition
  6: u64,    ; dispute_window_sec
  7: unix_time ; expiry
}

EscrowReleasePayload = {
  0: id64,   ; escrow_id
  1: hash32, ; evidence_receipt_hash
  2: unix_time
}

EscrowDisputePayload = {
  0: id64,   ; escrow_id
  1: tstr,   ; reason
  2: hash32, ; evidence_anchor_or_receipt
  3: unix_time
}

EscrowResolvePayload = {
  0: id64,   ; escrow_id
  1: u8,     ; outcome: 0=release_to_payee,1=refund_payer,2=split,3=slash
  ?2: u64,   ; split_amount_to_payee (if outcome=split)
  3: unix_time
}

; --- Skill module payloads ---

SkillArtifact = {
  0: u8,      ; kind
  1: hash32,  ; digest
  2: u64,     ; size
  3: [* tstr] ; uris
}

SkillManifestPayload = {
  0: id128,        ; skill_id
  1: did,          ; author
  2: tstr,         ; name
  3: tstr,         ; version
  4: tstr,         ; summary
  5: tstr,         ; license
  6: [* tstr],     ; capabilities
  7: [* tstr],     ; permissions
  8: u16,          ; sandbox_class
  ?9: [* tstr],    ; endpoints
  ?10: [* SkillArtifact], ; artifacts
  ?11: [* tstr],   ; requirements
  ?12: any,        ; pricing
  ?13: any,        ; attestations
  ?14: any,        ; metadata
  15: unix_time
}

SkillManifest = SkillManifestPayload & { 16: sig64 }

SkillPublishPayload = {
  0: bstr,     ; skill manifest bytes
  1: unix_time
}

SkillUpdatePayload = {
  0: id128,    ; skill_id
  1: hash32,   ; prev_manifest_hash
  2: bstr,     ; skill manifest bytes
  3: unix_time
}

SkillRevokePayload = {
  0: id128,    ; skill_id
  1: hash32,   ; manifest_hash
  2: tstr,     ; reason
  3: unix_time
}

; --- Work module payloads ---

WorkMilestone = {
  0: id64,     ; milestone_id
  1: tstr,     ; description
  2: unix_time,
  3: u64,      ; amount
  ?4: hash32   ; deliverable_hash
}

WorkOfferPayload = {
  0: id64,     ; offer_id
  1: did,      ; issuer
  2: tstr,     ; title
  3: tstr,     ; summary
  4: tstr,     ; scope
  5: u64,      ; budget_amount
  6: tstr,     ; budget_currency
  7: u64,      ; duration_sec
  8: [* tstr], ; deliverables
  ?9: [* tstr], ; requirements
  10: unix_time,
  11: unix_time ; exp
}

WorkOffer = WorkOfferPayload & { 16: sig64 }

WorkAgreementPayload = {
  0: id64,     ; agreement_id
  1: id64,     ; offer_id
  2: did,      ; issuer
  3: did,      ; counterparty
  4: u64,      ; budget_amount
  5: tstr,     ; budget_currency
  6: unix_time,
  7: unix_time,
  8: [* tstr], ; deliverables
  ?9: [* WorkMilestone],
  ?10: id64,   ; escrow_id
  ?11: any,    ; dispute_policy
  12: unix_time
}

WorkAgreement = WorkAgreementPayload & { 16: sig64 }

WorkOfferPublishPayload = {
  0: bstr,     ; work offer bytes
  1: unix_time
}

WorkAgreementPublishPayload = {
  0: bstr,     ; work agreement bytes
  1: unix_time
}

WorkAgreementUpdatePayload = {
  0: id64,     ; agreement_id
  1: hash32,   ; prev_agreement_hash
  2: bstr,     ; work agreement bytes
  3: unix_time
}

WorkAgreementClosePayload = {
  0: id64,     ; agreement_id
  1: hash32,   ; agreement_hash
  2: tstr,     ; reason
  3: unix_time
}

; --- Governance payloads ---

GovProposalPayload = {
  0: id64,    ; proposal_id
  1: u8,      ; domain: 0=protocol,1=community,2=certification
  2: u8,      ; type: registry (param_change, policy_update, spend, upgrade)
  3: tstr,    ; title
  4: tstr,    ; summary
  5: any,     ; changes (opaque)
  6: any,     ; trial spec (opaque, but SHOULD include metrics and rollback)
  7: unix_time
}

GovVotePayload = {
  0: id64,    ; proposal_id
  1: did,     ; voter
  2: u8,      ; chamber: 0=stakeholders,1=operators
  3: u8,      ; vote: 0=no,1=yes,2=abstain
  4: u64,     ; weight (computed off voter eligibility rules)
  5: unix_time
}

GovFinalizePayload = {
  0: id64,    ; proposal_id
  1: u8,      ; outcome: 0=rejected,1=approved,2=trial_started,3=finalized,4=rolled_back
  2: unix_time
}
